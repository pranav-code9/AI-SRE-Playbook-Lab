# Copy to lab/config.env and fill in. lab/config.env is gitignored.

PROJECT_ID=your-gcp-project
REGION=asia-south1
ZONE=asia-south1-a
CLUSTER_NAME=ai-sre-lab
MACHINE_TYPE=e2-standard-4
NUM_NODES=2

NAMESPACE=otel-demo
RELEASE=otel-demo
# Pin this. The demo chart does not support upgrading between chart versions.
CHART_VERSION=

# Patched checkout image, built by lab/scripts/build-checkout.sh.
# Leave at 0 for the first install (upstream image); set to 1 after make build.
USE_PATCHED_CHECKOUT=0
AR_REPO=ai-sre-lab
CHECKOUT_TAG=lab-1

# Path to a clone of open-telemetry/opentelemetry-demo, checked out at the
# tag matching the pinned chart's appVersion.
DEMO_SRC=../opentelemetry-demo

# Scenario timing, in seconds
BASELINE_SECONDS=900
FAULT_SECONDS=900
